{
  "info": {
    "_postman_id": "b1a2c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
    "name": "Tasks - Pagination, Filtering & Sorting",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Valid Requests",
      "item": [
        {
          "name": "Get All (defaults - page 1, pageSize 10)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:7011/api/v2/tasks",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7011",
              "path": ["api", "v2", "tasks"]
            }
          },
          "response": []
        },
        {
          "name": "Search + Filter + Page + Sort (acceptance criteria example)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:7011/api/v2/tasks?search=meeting&isCompleted=false&page=1&pageSize=5&sortBy=title",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7011",
              "path": ["api", "v2", "tasks"],
              "query": [
                { "key": "search", "value": "meeting" },
                { "key": "isCompleted", "value": "false" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "5" },
                { "key": "sortBy", "value": "title" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Filter by Status, sorted descending",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:7011/api/v2/tasks?status=pending&sortBy=dueDate&order=desc",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7011",
              "path": ["api", "v2", "tasks"],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "sortBy", "value": "dueDate" },
                { "key": "order", "value": "desc" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Page 2 with a smaller page size",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:7011/api/v2/tasks?page=2&pageSize=3",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7011",
              "path": ["api", "v2", "tasks"],
              "query": [
                { "key": "page", "value": "2" },
                { "key": "pageSize", "value": "3" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "BONUS - CreatedAfter / CreatedBefore date range",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:7011/api/v2/tasks?createdAfter=2026-01-01T00:00:00Z&createdBefore=2026-12-31T23:59:59Z",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7011",
              "path": ["api", "v2", "tasks"],
              "query": [
                { "key": "createdAfter", "value": "2026-01-01T00:00:00Z" },
                { "key": "createdBefore", "value": "2026-12-31T23:59:59Z" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "BONUS - Date range + search + pagination combined",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:7011/api/v2/tasks?search=meeting&createdAfter=2026-01-01T00:00:00Z&createdBefore=2026-12-31T23:59:59Z&page=1&pageSize=5",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7011",
              "path": ["api", "v2", "tasks"],
              "query": [
                { "key": "search", "value": "meeting" },
                { "key": "createdAfter", "value": "2026-01-01T00:00:00Z" },
                { "key": "createdBefore", "value": "2026-12-31T23:59:59Z" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "5" }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Edge Cases",
      "item": [
        {
          "name": "Unknown sortBy falls back to default (no crash)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:7011/api/v2/tasks?sortBy=notARealField",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7011",
              "path": ["api", "v2", "tasks"],
              "query": [
                { "key": "sortBy", "value": "notARealField" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "pageSize over 100 gets capped",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:7011/api/v2/tasks?pageSize=500",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7011",
              "path": ["api", "v2", "tasks"],
              "query": [
                { "key": "pageSize", "value": "500" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Search with no matches (empty data, correct metadata)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:7011/api/v2/tasks?search=zzznomatch",
              "protocol": "https",
              "host": ["localhost"],
              "port": "7011",
              "path": ["api", "v2", "tasks"],
              "query": [
                { "key": "search", "value": "zzznomatch" }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
