    "/api/users/login": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Logs in a new user.",
        "parameters": [
          {
            "name": "api-version",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "The new user's name, email, password, and role.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserRequestDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserRequestDTO"
              }
            },
            "application/*+json": {
